# Sepolia RPC URL (e.g., Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Testnet Deployer Private Key (without 0x prefix)
DEPLOYER_PRIVATE_KEY=your_testnet_account_private_key_without_0x

# Optional: Etherscan API key for contract source verification
ETHERSCAN_API_KEY=optional_etherscan_key_for_verification
